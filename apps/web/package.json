{
  "name": "@platformer/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js App Router shell (lobby, HUD, overlays) hosting the browser-only Phaser 4 client.",
  "scripts": {
    "predev": "node ../../scripts/sync-assets.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node ../../scripts/sync-assets.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@platformer/shared": "*",
    "next": "^16.4.6",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
