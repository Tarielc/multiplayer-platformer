# Copy to apps/server/.env (optional; these are the defaults).
PORT=3001
HOST=0.0.0.0

# Access-Control-Allow-Origin for the HTTP API (/health, /rooms, /leaderboard).
CORS_ORIGIN=*
# Comma-separated browser origins allowed to open WebSockets. Empty = allow all.
# ALLOWED_ORIGINS=http://localhost:3000,https://my-game.example.com

# Folder with maps/ and tilesets/ (defaults to packages/shared/data).
# DATA_DIR=../../packages/shared/data

# Dev-only client commands (skip level, respawn). Default: on unless NODE_ENV=production.
# DEV_COMMANDS=true
# Reload maps when files under DATA_DIR change. Default: on unless NODE_ENV=production.
# WATCH_LEVELS=true
# Joining an unknown room code creates the room.
AUTO_CREATE_ROOMS=true
MAX_ROOMS=500
# debug | info | warn | error
LOG_LEVEL=info

# Leaderboard (fastest runs). MongoDB connection string, e.g. a local server or an Atlas
# mongodb+srv:// URI. Unset = leaderboard off; the game runs normally either way.
# MONGODB_URI=mongodb://127.0.0.1:27017
# Database holding the `runs` collection.
# MONGODB_DB=platformer
